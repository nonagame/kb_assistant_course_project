Content-Disposition: form-data; name="visibility"

internal
--AudioBoundary
Content-Disposition: form-data; name="file"; filename="mingchuan_knowledge.mp3"
Content-Type: audio/mpeg

< ./data/sample/mingchuan_knowledge.mp3
--AudioBoundary--

