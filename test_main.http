### 上传企业制度文件
# @timeout 300
POST {{baseUrl}}/knowledge/documents
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data;boundary=KnowledgeBoundary

--KnowledgeBoundary
Content-Disposition:form-data;name="visibility"

public
--KnowledgeBoundary
Content-Disposition: form-data;name="file"; filename="明川科技员工日常办公与业务管理制度.md"
Content-Type: text/markdown;charset=utf-8

< ./data/sample/明川科技员工日常办公与业务管理制度.md
--KnowledgeBoundary--

#@documentId = 填写阶段C响应中的实际id,在kb_documents表可以直接查看
#@documentSourcePath = 填写阶段C响应中的实际source_path，位于data文件夹

### 分页查询文档-查看上传记录
GET {{baseUrl}}/knowledge/documents?page=1&page_size=20
Authorization: Bearer {{adminToken}}

### 不允许第0页
GET {{baseUrl}}/knowledge/documents?page=0&page_size=20
Authorization: Bearer {{adminToken}}

### 不允许每页超过100条
GET {{baseUrl}}/knowledge/documents?page=1&page_size=101
Authorization: Bearer {{adminToken}}

### 普通用户无管理列表权限
GET {{baseUrl}}/knowledge/documents
Authorization: Bearer {{publicToken}}

### 修改文档可见范围：将公开文档改为内部文档
# @timeout 300
PATCH {{baseUrl}}/knowledge/documents/{{documentId}}/visibility
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"visibility": "internal"}

### 删除本模块上传的文件
DELETE {{baseUrl}}/knowledge/documents/{{documentId}}
Authorization: Bearer {{adminToken}}

### 删除后查询列表
GET {{baseUrl}}/knowledge/documents?page=1&page_size=20
Authorization: Bearer {{adminToken}}

### 重复删除
DELETE {{baseUrl}}/knowledge/documents/{{documentId}}
Authorization: Bearer {{adminToken}}

### 重建当前知识库
# @timeout 300
POST {{baseUrl}}/knowledge/reindex
Authorization: Bearer {{adminToken}}

### 普通用户不能重建
POST {{baseUrl}}/knowledge/reindex
Authorization: Bearer {{publicToken}}

### 普通用户查看索引状态
GET {{baseUrl}}/knowledge/status
Authorization: Bearer {{publicToken}}

### 管理员查看索引状态
GET {{baseUrl}}/knowledge/status
Authorization: Bearer {{adminToken}}

### 未登录不能查询
GET {{baseUrl}}/knowledge/status


### A1 管理员查询角色
GET {{baseUrl}}/admin/roles
Authorization: Bearer {{adminToken}}

### A1 普通用户查询角色
GET {{baseUrl}}/admin/roles
Authorization: Bearer {{publicToken}}

### A1 未登录查询角色
GET {{baseUrl}}/admin/roles

### A2 管理员查询权限字典
GET {{baseUrl}}/admin/permissions
Authorization: Bearer {{adminToken}}

### A2 普通用户查询权限字典
GET {{baseUrl}}/admin/permissions
Authorization: Bearer {{publicToken}}

### A2 未登录查询权限字典
GET {{baseUrl}}/admin/permissions

### A3 清理重复和空白权限码
PUT {{baseUrl}}/admin/roles/public/permissions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"permission_codes":[
  "kb.view_public",
  "kb.view_internal",
  "system.manage_users"
]}

### A3 拒绝移除public必要权限
PUT {{baseUrl}}/admin/roles/public/permissions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"permission_codes":[]}

### A3 拒绝不存在的权限
PUT {{baseUrl}}/admin/roles/public/permissions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"permission_codes":[
  "kb.view_public",
  "kb.not_exists"
]}

### A3 角色不存在
PUT {{baseUrl}}/admin/roles/not_exists/permissions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"permission_codes":["kb.view_public"]}

### A3 普通用户无权修改角色权限
PUT {{baseUrl}}/admin/roles/public/permissions
Authorization: Bearer {{publicToken}}
Content-Type: application/json

{"permission_codes":["kb.view_public"]}


